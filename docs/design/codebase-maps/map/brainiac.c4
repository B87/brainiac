// Brainiac's codebase map: a prototype for docs/design/codebase-maps.md.
// Facts (modules, files, sizes, imports and the names they use) were computed
// from the sources; descriptions, labels, grouping, and which edges to draw
// were chosen by the AI over those facts.

specification {
  element person {
    style {
      shape person
      color green
    }
  }
  element app {
    style {
      color indigo
    }
  }
  element layer {
    style {
      color muted
      border dashed
    }
  }
  element feature {
    style {
      color sky
    }
  }
  element module {
    style {
      color slate
    }
  }
  element file {
    style {
      color gray
      size small
    }
  }
  element ui {
    style {
      shape browser
      color secondary
    }
  }
  element store {
    style {
      shape storage
      color amber
    }
  }
  element process {
    style {
      color indigo
    }
  }
  element sandbox {
    style {
      color red
      border dashed
    }
  }
  element external {
    style {
      color gray
      border dashed
    }
  }

  relationship uses {
    color slate
  }
  relationship invokes {
    color sky
  }
  relationship emits {
    color amber
    line dashed
  }
  relationship stores {
    color amber
    line dotted
  }
  relationship spawns {
    color red
  }
  relationship network {
    color gray
    line dashed
  }

  // An import outside the boundary rules, listed in ALLOWED.
  tag exception
}

model {
  dev = person 'Developer' {
    description 'Tracks repositories, reads changes, keeps notes, runs agents'
  }

  // --- Outside Brainiac -----------------------------------------------------
  repos = external 'Your repositories' {
    icon tech:git
    description 'Read only: inspection and fetch, never a write'
  }
  vaultFolder = external 'Vault folder' {
    icon tech:markdown
    description 'Ordinary Markdown files, the source of truth for notes'
  }
  gitCli = external 'git' {
    icon tech:git
    description 'The system Git CLI, always with argument arrays'
  }
  docker = external 'Docker' {
    icon tech:docker
    description 'Containers for agent runs, here or on an approved Linux host'
  }
  providers = external 'AI providers' {
    icon tech:claude
    description 'Claude Code and OpenCode agents call their providers from the container'
  }
  forges = external 'GitHub and Bitbucket' {
    icon tech:github
    description 'Pull requests over HTTPS, tokens only in the Keychain'
  }
  dbServers = external 'Your databases' {
    icon tech:postgresql
    description 'PostgreSQL and SQLite, read only unless a tab allows writes'
  }
  keychain = external 'macOS Keychain' {
    icon tech:apple
    description 'Account tokens and database passwords'
  }
  agentsOutside = external 'Other agents (MCP)' {
    description 'Claude Desktop and others, through brainiac mcp'
  }

  brainiac = app 'Brainiac' {
    icon tech:tauri
    description 'A macOS app: Rust backend in a Tauri v2 shell, React frontend'

    // --- Frontend -----------------------------------------------------------
    frontend = layer 'Frontend' {
      technology 'React, TypeScript (src/)'
      description 'Views and dialogs; reaches the backend only through ipc.ts'

      appShell = ui 'App shell' {
        icon tech:react
        description 'App.tsx (1,185 lines), Sidebar, CommandPalette, StatusBar, SettingsPage: each imports every feature by name'
        link https://github.com/B87/brainiac/blob/main/src/App.tsx 'App.tsx'
      }
      gitViewer = ui 'Git viewer' {
        description 'Dashboard, RepositoryView, ChangesTab, HistoryTab, BranchesTab, CommitDetails, BranchComparison, DiffView'
      }
      notesUi = ui 'Notes and tasks UI' {
        description 'NotesView, NoteEditor, NoteTree, TasksView, TaskEditor, TodayView, VaultSetup'
      }
      prUi = ui 'Pull requests UI' {
        description 'PullRequestsTab, PullRequestView, AccountsSection'
      }
      dbUi = ui 'Databases UI' {
        description 'DatabasesView, DbQueryTab, DbResults, DbConnectionDialog, DbHealth'
      }
      runsUi = ui 'Agent runs UI' {
        description 'RunsView, NewRunDialog, AgentProfilePage, RunHostPage, HostJobView'
      }
      explainUi = ui 'Explanations UI' {
        description 'ExplainDialog, ExplanationPanel, useExplainedPatch, ExplanationsPane'
      }
      ipc = ui 'ipc.ts' {
        icon tech:typescript
        description 'Hand-written invoke wrappers and event names (1,097 lines); DTO types generated by ts-rs'
        link https://github.com/B87/brainiac/blob/main/src/lib/ipc.ts 'src/lib/ipc.ts'
      }
    }

    // --- Shell --------------------------------------------------------------
    shell = layer 'Shell' {
      technology 'Rust'
      description 'Wires everything together; the only code that may import anything'

      lib = module 'lib' {
        description 'The setup block builds every service by hand and connects each emitter to the window (926 lines)'
        link https://github.com/B87/brainiac/blob/main/src-tauri/src/lib.rs 'lib.rs'
      }
      commands = module 'commands' {
        description '187 Tauri commands, thin handlers over the services (1,774 lines)'
        link https://github.com/B87/brainiac/blob/main/src-tauri/src/commands.rs 'commands.rs'
      }
    }

    // --- Core ---------------------------------------------------------------
    core = layer 'Core' {
      technology 'Rust'
      description 'What every feature needs and no feature owns. Imports only the core.'

      models = module 'models' {
        description 'Every DTO, exported to TypeScript (4,740 lines). Imported by nearly every module, so not drawn.'
      }
      db = module 'db' {
        description 'SQLite workers, migrations, backups, and the shared stores (Stores)'
        link https://github.com/B87/brainiac/blob/main/src-tauri/src/db.rs 'db.rs'
      }
      events = module 'events' {
        description 'One typed channel: Emitter<E>, Notifier, FrontendEvent names'
      }
      git = module 'git' {
        description 'Git inspection over the CLI: status, log, diffs, branches, IsolatedGit (2,916 lines)'
      }
      hosting = module 'hosting' {
        description 'Which GitHub or Bitbucket repository an origin names (ForgeRepository)'
      }
      workspaces = module 'workspaces' {
        description 'RepositoryService: registration, membership, relocation, the feed (2,964 lines)'
      }
      activity = module 'activity' {
        description 'What changed in each checkout, and drift'
      }
      fetcher = module 'fetcher' {
        description 'Fetch now and opt-in auto-fetch, the one Git write'
      }
      watcher = module 'watcher' {
        description 'File events for tracked checkouts'
      }
      credentials = module 'credentials' {
        description 'CredentialService: sources, bindings, leases, Keychain items (1,912 lines)'
      }
      sharing = module 'sharing' {
        description 'Whether a repository code may go to a provider: one answer per repository and provider'
      }
      machines = module 'machines' {
        description 'Approved SSH hosts for remote runs'
      }
      backup = module 'backup' {
        description 'Export and restore; names notes and tasks until it becomes a registry'
      }
      mcp = module 'mcp' {
        description 'Agent access: MCP over a Unix socket, tools over notes, tasks, repositories'
      }
      secrets = module 'secrets' {
        description 'Settings → Secrets: lists every owner of a secret (80 lines)'
      }
    }

    // --- Features -----------------------------------------------------------
    knowledge = feature 'Notes and tasks' {
      technology 'v0.2'
      description 'One feature in practice: tasks are built on notes'
      noteSvc = module 'notes' {
        description 'NoteService: read, save, rename, trash, revisions, drafts, links (3,131 lines)'
      }
      tasks = module 'tasks' {
        description 'TaskService, built on NoteService'
      }
      index = module 'index' {
        description 'index.db: note bodies, keyword search, links between notes'
      }
      vault = module 'vault' {
        description 'Reconciliation and the vault watcher'
      }
    }
    pullRequests = feature 'Pull requests' {
      technology 'v0.3'
      forge = module 'forge' {
        description 'PullRequestService over one ForgeAdapter per provider; cache in forge.db (7,510 lines)'
      }
    }
    databases = feature 'Databases' {
      technology 'v0.4'
      description 'The one leaf: only the shell and Secrets import it'
      dbs = module 'databases' {
        description 'Connections, one session per query tab, read-only statements, health (7,531 lines)'
      }
    }
    runs = feature 'Agent runs' {
      technology 'v0.5'
      agents = module 'agents' {
        description 'AgentRunService, profiles, hosts, artifacts, the controller client (16,720 lines, the largest module)'
        runsRs = file 'runs.rs' {
          description 'AgentRunService: start, follow, collect, discard (2,590 lines)'
        }
        controllerRs = file 'controller/' {
          description 'The run controller: ACP sessions, journal, deadlines, Docker'
        }
        repositoryRs = file 'repository.rs' {
          description 'Brainiac bare repositories and RunArtifacts'
        }
        runtimeRs = file 'runtime.rs' {
          description 'The app side of the controller: connects, or starts brainiac runner'
        }
        hostsRs = file 'hosts.rs' {
          description 'Remote run hosts and host jobs'
        }
      }
    }
    explanations = feature 'Explanations' {
      technology 'v0.6'
      description 'Built on agent runs; nothing imports it back'
      explain = module 'explain' {
        description 'ExplanationService: the explain run, checks, ledger (4,901 lines)'
        serviceRs = file 'service.rs' {
          description 'Starts explain runs, follows them, imports the result'
        }
        checkRs = file 'check.rs' {
          description 'Anchors each note to the change and finds each quote verbatim'
        }
        storeRs = file 'store.rs' {
          description 'Explanations in history.db; the concept ledger in brainiac.db'
        }
        subjectRs = file 'subject.rs' {
          description 'Reads the commit or range being explained'
        }
        promptRs = file 'prompt.rs' {
          description 'The prompt Brainiac writes'
        }
        knownRs = file 'known.rs' {
          description 'The known-concepts file sent to the run'
        }
      }
    }

    // --- Processes and storage ----------------------------------------------
    runner = process 'Run controller' {
      technology 'brainiac runner'
      description 'A process of its own that owns each run: session, deadline, journal, container'
    }
    container = sandbox 'Run container' {
      icon tech:docker
      description 'The agent works on a copy of one commit; Brainiac reads back only its result file'
      entrypoint = file 'entrypoint.mjs' {
        description 'Reads the credential from stdin, clones input.bundle into /workspace, starts the agent'
      }
      workspace = store '/workspace' {
        description 'The copy of the commit the agent works on; only .brainiac/explanation.json is read back'
      }
      agent = process 'Agent' {
        icon tech:claude
        description 'Claude Code or OpenCode over ACP'
      }
    }
    brainiacDb = store 'brainiac.db' {
      icon tech:sqlite
      description 'What cannot be rebuilt: repositories, settings, tasks, connections, the ledger'
    }
    indexDb = store 'index.db' {
      icon tech:sqlite
      description 'Derived from the vault; can be deleted'
    }
    historyDb = store 'history.db' {
      icon tech:sqlite
      description 'Revisions, drafts, query history, runs, explanations'
    }
    forgeDb = store 'forge.db' {
      icon tech:sqlite
      description 'Pull request cache, rebuilt from the providers'
    }
  }

  // --- The developer and the outside --------------------------------------
  dev -> brainiac.frontend 'uses'
  agentsOutside -> brainiac.core.mcp 'calls tools' {
    technology 'MCP over a Unix socket'
  }

  // --- Frontend to backend ------------------------------------------------
  brainiac.frontend.appShell -> brainiac.frontend.gitViewer 'routes to'
  brainiac.frontend.appShell -> brainiac.frontend.notesUi 'routes to'
  brainiac.frontend.appShell -> brainiac.frontend.prUi 'routes to'
  brainiac.frontend.appShell -> brainiac.frontend.dbUi 'routes to'
  brainiac.frontend.appShell -> brainiac.frontend.runsUi 'routes to'
  brainiac.frontend.gitViewer -> brainiac.frontend.explainUi 'puts the panel beside the patch'
  brainiac.frontend.prUi -> brainiac.frontend.explainUi 'Files Changed explanation'
  brainiac.frontend.runsUi -> brainiac.frontend.explainUi 'run result explanation'
  brainiac.frontend.gitViewer -> brainiac.frontend.ipc 'calls'
  brainiac.frontend.notesUi -> brainiac.frontend.ipc 'calls'
  brainiac.frontend.prUi -> brainiac.frontend.ipc 'calls'
  brainiac.frontend.dbUi -> brainiac.frontend.ipc 'calls'
  brainiac.frontend.runsUi -> brainiac.frontend.ipc 'calls'
  brainiac.frontend.explainUi -> brainiac.frontend.ipc 'calls'
  brainiac.frontend.ipc -[invokes]-> brainiac.shell.commands 'invoke(command, args)' {
    technology 'Tauri IPC'
  }
  brainiac.shell.lib -[emits]-> brainiac.frontend.ipc 'change events to the window' {
    technology 'Tauri events'
  }

  // --- The shell wires and calls everything --------------------------------
  brainiac.shell.lib -[uses]-> brainiac.core 'builds the services'
  brainiac.shell.lib -[uses]-> brainiac.knowledge 'builds NoteService, TaskService'
  brainiac.shell.lib -[uses]-> brainiac.pullRequests 'builds PullRequestService'
  brainiac.shell.lib -[uses]-> brainiac.databases 'builds ConnectionService, QuerySessions'
  brainiac.shell.lib -[uses]-> brainiac.runs 'builds AgentRunService'
  brainiac.shell.lib -[uses]-> brainiac.explanations 'builds ExplanationService'
  brainiac.shell.commands -[uses]-> brainiac.core 'calls'
  brainiac.shell.commands -[uses]-> brainiac.knowledge 'calls'
  brainiac.shell.commands -[uses]-> brainiac.pullRequests 'calls'
  brainiac.shell.commands -[uses]-> brainiac.databases 'calls'
  brainiac.shell.commands -[uses]-> brainiac.runs 'calls'
  brainiac.shell.commands -[uses]-> brainiac.explanations 'calls'

  // --- Inside the core (imports, labelled by the names they use) -----------
  brainiac.core.workspaces -[uses]-> brainiac.core.git 'GitService, LogQuery, Checkout'
  brainiac.core.workspaces -[uses]-> brainiac.core.activity 'ActivityTracker'
  brainiac.core.workspaces -[uses]-> brainiac.core.fetcher 'Fetcher'
  brainiac.core.workspaces -[uses]-> brainiac.core.hosting 'ForgeRepository'
  brainiac.core.workspaces -[uses]-> brainiac.core.db 'repository and workspace rows'
  brainiac.core.workspaces -[emits]-> brainiac.core.events 'workspace changes'
  brainiac.core.activity -[uses]-> brainiac.core.git 'Checkout, RefName'
  brainiac.core.fetcher -[uses]-> brainiac.core.git 'busy_lock, RefName'
  brainiac.core.fetcher -[uses]-> brainiac.core.activity 'refspec_pattern_ok'
  brainiac.core.watcher -[uses]-> brainiac.core.workspaces 'RepositoryService'
  brainiac.core.db -[uses]-> brainiac.core.hosting 'ForgeRepository'
  brainiac.core.db -[uses]-> brainiac.core.git 'Checkout'
  brainiac.core.sharing -[uses]-> brainiac.core.db 'code_answers'
  brainiac.core.machines -[uses]-> brainiac.core.db 'approved hosts'
  brainiac.core.secrets -[uses]-> brainiac.core.credentials 'CredentialService'
  brainiac.core.mcp -[uses]-> brainiac.core.workspaces 'RepositoryService'
  brainiac.core.git -[network]-> gitCli 'runs'
  brainiac.core.git -> repos 'reads'
  brainiac.core.fetcher -> repos 'fetches remote-tracking refs and tags'
  brainiac.core.credentials -> keychain 'reads and writes its own items'

  // --- Core modules that name features (ALLOWED) ---------------------------
  brainiac.core.backup -[uses]-> brainiac.knowledge.noteSvc 'export reads the vault' {
    #exception
  }
  brainiac.core.backup -[uses]-> brainiac.knowledge.tasks 'export writes tasks.json' {
    #exception
  }
  brainiac.core.backup -[uses]-> brainiac.knowledge.index 'restore rebuilds search' {
    #exception
  }
  brainiac.core.mcp -[uses]-> brainiac.knowledge.noteSvc 'note tools' {
    #exception
  }
  brainiac.core.mcp -[uses]-> brainiac.knowledge.tasks 'task tools' {
    #exception
  }
  brainiac.core.mcp -[uses]-> brainiac.knowledge.index 'search tool' {
    #exception
  }
  brainiac.core.secrets -[uses]-> brainiac.runs.agents 'profiles with a secret' {
    #exception
  }
  brainiac.core.secrets -[uses]-> brainiac.databases.dbs 'connections with a password' {
    #exception
  }
  brainiac.core.secrets -[uses]-> brainiac.pullRequests.forge 'accounts with a token' {
    #exception
  }

  // --- Notes and tasks -------------------------------------------------------
  brainiac.knowledge.tasks -[uses]-> brainiac.knowledge.noteSvc 'built on NoteService'
  brainiac.knowledge.noteSvc -[uses]-> brainiac.knowledge.index 'IndexDoc, EDIT_LIMIT'
  brainiac.knowledge.noteSvc -[uses]-> brainiac.knowledge.vault 'WatchState'
  brainiac.knowledge.vault -[uses]-> brainiac.knowledge.index 'indexes in batches'
  brainiac.knowledge.noteSvc -[uses]-> brainiac.core.db 'Stores'
  brainiac.knowledge.noteSvc -[emits]-> brainiac.core.events 'KnowledgeEvent'
  brainiac.knowledge.noteSvc -> vaultFolder 'reads and saves notes'
  brainiac.knowledge.vault -> vaultFolder 'watches'
  brainiac.knowledge.noteSvc -[stores]-> brainiac.historyDb 'revisions, drafts'
  brainiac.knowledge.index -[stores]-> brainiac.indexDb 'bodies, search, links'
  brainiac.knowledge.tasks -[stores]-> brainiac.brainiacDb 'tasks'

  // --- Pull requests ---------------------------------------------------------
  brainiac.pullRequests.forge -[uses]-> brainiac.core.credentials 'tokens (Lease)'
  brainiac.pullRequests.forge -[uses]-> brainiac.core.hosting 'ForgeRepository'
  brainiac.pullRequests.forge -[uses]-> brainiac.core.workspaces 'RepositoryService'
  brainiac.pullRequests.forge -[uses]-> brainiac.core.git 'parse_unified_diff'
  brainiac.pullRequests.forge -[emits]-> brainiac.core.events 'pr_changed'
  brainiac.pullRequests.forge -[network]-> forges 'REST APIs' {
    technology 'reqwest, rustls'
  }
  brainiac.pullRequests.forge -[stores]-> brainiac.forgeDb 'cache'

  // --- Databases -------------------------------------------------------------
  brainiac.databases.dbs -[uses]-> brainiac.core.credentials 'passwords (LeaseHandle)'
  brainiac.databases.dbs -[emits]-> brainiac.core.events 'connection health'
  brainiac.databases.dbs -[network]-> dbServers 'read-only sessions' {
    technology 'tokio-postgres, rusqlite'
  }
  brainiac.databases.dbs -[stores]-> brainiac.brainiacDb 'connections, saved queries'
  brainiac.databases.dbs -[stores]-> brainiac.historyDb 'query history'

  // --- Agent runs ------------------------------------------------------------
  brainiac.runs.agents -[uses]-> brainiac.core.credentials 'the profile key (Binding)'
  brainiac.runs.agents -[uses]-> brainiac.core.sharing 'CodeSharingService'
  brainiac.runs.agents -[uses]-> brainiac.core.machines 'MachineService, ssh'
  brainiac.runs.agents -[uses]-> brainiac.core.workspaces 'RepositoryService'
  brainiac.runs.agents -[uses]-> brainiac.core.git 'IsolatedGit'
  brainiac.runs.agents -[uses]-> brainiac.core.mcp 'socket helpers'
  brainiac.runs.agents -[emits]-> brainiac.core.events 'AgentRunChangedEvent'
  brainiac.runs.agents.runsRs -> brainiac.runner 'starts and reconnects' {
    technology 'local socket'
  }
  brainiac.runs.agents.runsRs -> brainiac.runs.agents.repositoryRs 'copies one commit'
  brainiac.runs.agents.repositoryRs -> repos 'reads one commit and its history'
  brainiac.runs.agents.hostsRs -> brainiac.core.machines 'approved hosts'
  brainiac.runner -[spawns]-> brainiac.container 'one container per run'
  brainiac.runs.agents.runsRs -> brainiac.runs.agents.runtimeRs 'hands the run over'
  brainiac.runs.agents.runtimeRs -> brainiac.runner 'Start, Prompt, ReadExplanation, Discard' {
    technology 'Unix socket'
  }
  brainiac.container.entrypoint -> brainiac.container.agent 'starts'
  brainiac.container.entrypoint -> brainiac.container.workspace 'clones input.bundle'
  brainiac.container.agent -> brainiac.container.workspace 'reads and writes'
  brainiac.runner -> brainiac.container.agent 'session/prompt' {
    technology 'ACP over stdin/stdout'
  }
  brainiac.runner -> docker 'docker CLI'
  brainiac.container -[network]-> providers 'the agent calls its model'
  brainiac.runs.agents -[stores]-> brainiac.historyDb 'runs'

  // --- Explanations ----------------------------------------------------------
  brainiac.explanations.explain -[uses]-> brainiac.runs.agents 'an explanation is an agent run of its own kind' {
    #exception
  }
  brainiac.explanations.explain -[uses]-> brainiac.pullRequests.forge 'PullRequestFacts' {
    #exception
  }
  brainiac.explanations.explain -[uses]-> brainiac.knowledge.noteSvc 'Save as note' {
    #exception
  }
  brainiac.explanations.explain -[uses]-> brainiac.core.sharing 'asks once per repository'
  brainiac.explanations.explain -[uses]-> brainiac.core.git 'IsolatedGit'
  brainiac.explanations.explain -[emits]-> brainiac.core.events 'explanation changes'
  brainiac.explanations.explain.serviceRs -> brainiac.explanations.explain.subjectRs 'reads the subject'
  brainiac.explanations.explain.serviceRs -> brainiac.explanations.explain.promptRs 'writes the prompt'
  brainiac.explanations.explain.serviceRs -> brainiac.explanations.explain.knownRs 'sends known concepts'
  brainiac.explanations.explain.serviceRs -> brainiac.explanations.explain.checkRs 'checks the result'
  brainiac.explanations.explain.serviceRs -> brainiac.explanations.explain.storeRs 'keeps it'
  brainiac.explanations.explain.storeRs -[stores]-> brainiac.historyDb 'explanations'
  brainiac.explanations.explain.storeRs -[stores]-> brainiac.brainiacDb 'concept ledger'
}

views {
  view index {
    title 'Brainiac in context'
    description 'Start here. Click Brainiac to open it; click any box with a view of its own to zoom in.'
    include *
  }

  view app of brainiac {
    title 'Brainiac: frontend, shell, core, features'
    description 'The shell may import anything, the core only the core, a feature the core and itself. Red-tagged arrows are the exceptions in ALLOWED.'
    include *
    exclude brainiac.core.models
    style brainiac.frontend, brainiac.shell, brainiac.core {
      color muted
    }
  }

  view frontend of brainiac.frontend {
    title 'Frontend'
    description 'Every view reaches the backend through ipc.ts. The App shell imports each feature by name.'
    include *
  }

  view core of brainiac.core {
    title 'The core'
    description 'models (every DTO) is left out: nearly every module imports it.'
    include *
    exclude brainiac.core.models
  }

  view knowledge of brainiac.knowledge {
    title 'Notes and tasks'
    include *
  }

  view pullRequests of brainiac.pullRequests {
    title 'Pull requests'
    include *
  }

  view databases of brainiac.databases {
    title 'Databases'
    include *
  }

  view runs of brainiac.runs {
    title 'Agent runs'
    include *, brainiac.runs.agents.*
  }

  view explanations of brainiac.explanations {
    title 'Explanations'
    include *, brainiac.explanations.explain.*
  }

  view exceptions {
    title 'The exceptions (ALLOWED)'
    description 'Every import outside the boundary rules, each with its reason in tests/module_boundaries.rs'
    include brainiac.** -> brainiac.** where tag is #exception
  }

  view storage {
    title 'Where data lives'
    description 'Which module writes which file'
    include brainiac.brainiacDb, brainiac.indexDb, brainiac.historyDb, brainiac.forgeDb, vaultFolder
    include * -> brainiac.brainiacDb, * -> brainiac.indexDb, * -> brainiac.historyDb, * -> brainiac.forgeDb, * -> vaultFolder
  }

  dynamic view explainStart {
    title 'Explain, part 1: from the click to a started run'
    description 'Explain on a commit in History. Part 2 follows the run.'

    brainiac.frontend.gitViewer -> brainiac.frontend.explainUi 'CommitDetails builds the subject {commit} and calls useExplainedPatch' {
      notes 'src/components/CommitDetails.tsx:124'
    }
    dev -> brainiac.frontend.explainUi 'clicks Explain (or presses E)' {
      notes 'src/components/useExplainedPatch.tsx:262'
    }
    brainiac.frontend.explainUi -> brainiac.frontend.ipc 'ExplainDialog loads profiles, hosts, answers, estimates' {
      notes 'src/components/ExplainDialog.tsx:62, ipc.getExplainDialog'
    }
    brainiac.frontend.ipc -> brainiac.shell.commands 'get_explain_dialog' {
      notes 'src-tauri/src/commands.rs:1580'
    }
    brainiac.shell.commands -> brainiac.explanations.explain.serviceRs 'dialog()' {
      notes 'src-tauri/src/explain/service.rs:414'
    }
    brainiac.explanations.explain.serviceRs -> brainiac.core.sharing 'question(): may this repository go to each provider?' {
      notes 'src-tauri/src/sharing.rs:84. A workspace No beats a Yes.'
    }
    brainiac.core.sharing -> brainiac.brainiacDb 'reads code_answers'
    dev -> brainiac.frontend.explainUi 'Allow and explain (first time) or Explain' {
      notes 'src/components/ExplainDialog.tsx:188'
    }
    brainiac.frontend.ipc -> brainiac.core.sharing 'answer_code_sharing (only if asked); emits code_sharing_changed' {
      notes 'src-tauri/src/sharing.rs:124'
    }
    brainiac.frontend.ipc -> brainiac.shell.commands 'start_explanation {repository, subject, profile, host, depth}' {
      notes 'src/components/ExplainDialog.tsx:143, src-tauri/src/commands.rs:1589'
    }
    brainiac.shell.commands -> brainiac.explanations.explain.serviceRs 'start()'
    brainiac.explanations.explain.serviceRs -> brainiac.core.sharing 'require(): refuses an unasked or a No' {
      notes 'src-tauri/src/explain/service.rs:753, src-tauri/src/sharing.rs:104'
    }
    brainiac.explanations.explain.serviceRs -> brainiac.explanations.explain.subjectRs 'resolve the commit: base, tip, title (git rev-parse)' {
      notes 'src-tauri/src/explain/service.rs:542'
    }
    brainiac.explanations.explain.serviceRs -> brainiac.explanations.explain.knownRs 'the known-concepts file from the ledger' {
      notes 'src-tauri/src/explain/service.rs:801'
    }
    brainiac.explanations.explain.serviceRs -> brainiac.explanations.explain.promptRs 'Brainiac writes the prompt' {
      notes 'src-tauri/src/explain/prompt.rs:36'
    }
    brainiac.explanations.explain.storeRs -> brainiac.historyDb 'a row: Working, step Copying' {
      notes 'src-tauri/src/explain/store.rs:204'
    }
    brainiac.explanations.explain.serviceRs -> brainiac.runs.agents.runsRs 'start_explain(prompt, model, time limit, known concepts)' {
      notes 'src-tauri/src/agents/runs.rs:591. Checks the answer again, then a run row with explain: true.'
    }
    brainiac.runs.agents.runsRs -> brainiac.historyDb 'the run row; emits agent_run_changed' {
      notes 'src-tauri/src/agents/runs.rs:719'
    }
    brainiac.explanations.explain.serviceRs -> brainiac.frontend.explainUi 'emits explanation_changed; the panel opens on Working' {
      notes 'src-tauri/src/explain/service.rs:890, src/components/useExplainedPatch.tsx:322'
    }
  }

  dynamic view explainRun {
    title 'Explain, part 2: the run, the checks, the panel'
    description 'Two loops talk through a broadcast channel lib.rs feeds from the run emitter: the run service sync loop and the explanation drive loop.'

    brainiac.runs.agents.runsRs -> brainiac.runs.agents.repositoryRs 'export the commit as input.bundle' {
      notes 'src-tauri/src/agents/repository.rs:338'
    }
    brainiac.runs.agents.runsRs -> brainiac.runs.agents.runtimeRs 'hand over the run' {
      notes 'src-tauri/src/agents/runs.rs:767'
    }
    brainiac.runs.agents.runtimeRs -> brainiac.runner 'connect, or start brainiac runner; Request::Start' {
      notes 'src-tauri/src/agents/runtime.rs:191 and :324'
    }
    brainiac.runner -> docker 'create the volume and container, upload input.bundle and known-concepts.tsv' {
      notes 'src-tauri/src/agents/controller/docker.rs:331'
    }
    brainiac.runner -> brainiac.container.entrypoint 'the credential, once, on stdin' {
      notes 'src-tauri/src/agents/image/entrypoint.mjs:24'
    }
    brainiac.container.entrypoint -> brainiac.container.agent 'clone the bundle into /workspace, start the agent' {
      notes 'src-tauri/src/agents/image/entrypoint.mjs:114'
    }
    brainiac.runner -> brainiac.container.agent 'initialize, session/new, session/prompt with the prompt' {
      notes 'src-tauri/src/agents/controller/acp.rs:258'
    }
    brainiac.container.agent -> providers 'reads the code, asks the model'
    brainiac.container.agent -> brainiac.container.workspace 'writes .brainiac/explanation.json' {
      notes 'src-tauri/src/explain/prompt.rs:101'
    }
    brainiac.runs.agents.runsRs -> brainiac.runner 'sync: poll events and status; emit agent_run_changed' {
      notes 'src-tauri/src/agents/runs.rs:1087'
    }
    brainiac.explanations.explain.serviceRs -> brainiac.historyDb 'drive: woken by the broadcast, saves the step (copying, starting, reading)' {
      notes 'src-tauri/src/explain/service.rs:965'
    }
    brainiac.explanations.explain.serviceRs -> brainiac.runner 'the turn ended: ReadExplanation' {
      notes 'src-tauri/src/explain/service.rs:1087, src-tauri/src/agents/runtime.rs:526'
    }
    brainiac.runner -> brainiac.container.workspace 'download only explanation.json, as one bounded regular file' {
      notes 'src-tauri/src/agents/controller/archive.rs:1'
    }
    brainiac.explanations.explain.serviceRs -> brainiac.explanations.explain.checkRs 'parse the schema, read the subject and cited files at the tip' {
      notes 'src-tauri/src/explain/check.rs:142'
    }
    brainiac.explanations.explain.checkRs -> brainiac.core.git 'IsolatedGit: the diff and the files'
    brainiac.explanations.explain.checkRs -> brainiac.explanations.explain.checkRs 'tour covers every file, notes anchor to changed lines, quotes found verbatim' {
      notes 'src-tauri/src/explain/check.rs:199'
    }
    brainiac.explanations.explain.serviceRs -> brainiac.runner 'first failure only: one follow-up prompt with the errors' {
      notes 'src-tauri/src/explain/service.rs:1140, src-tauri/src/explain/prompt.rs:121'
    }
    brainiac.explanations.explain.storeRs -> brainiac.historyDb 'Ready, with the checked explanation; cost and time' {
      notes 'src-tauri/src/explain/service.rs:1167, src-tauri/src/explain/store.rs:266'
    }
    brainiac.explanations.explain.serviceRs -> brainiac.runs.agents.runsRs 'cancel the run' {
      notes 'src-tauri/src/explain/service.rs:1021'
    }
    brainiac.runs.agents.runsRs -> brainiac.runner 'Discard: remove the container and volume, keep the journal' {
      notes 'src-tauri/src/agents/runs.rs:1687; retried hourly if it fails'
    }
    brainiac.explanations.explain.serviceRs -> brainiac.frontend.explainUi 'explanation_changed' {
      notes 'src/lib/useExplanation.ts:42 reloads with list_subject_explanations'
    }
    brainiac.frontend.explainUi -> brainiac.frontend.gitViewer 'the panel, the reading order, notes in the patch' {
      notes 'src/components/useExplainedPatch.tsx:107, src/components/ExplanationPanel.tsx:550'
    }
  }
}
