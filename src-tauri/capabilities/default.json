{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Capability for the main window: core IPC, native folder picker, opening paths in Finder, in-app updates.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:event:default",
    "dialog:allow-open",
    "opener:default",
    "updater:default",
    "process:allow-restart"
  ]
}
