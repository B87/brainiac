[Unit]
Description=Brainiac agent-controller spike guard
After=docker.service
Requires=docker.service

[Service]
Type=simple
User=@USER@
Group=@GROUP@
SupplementaryGroups=docker
ExecStart=@BIN@ guard --state /var/lib/brainiac-spike
Restart=always
RestartSec=1
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
